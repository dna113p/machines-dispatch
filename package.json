{
  "name": "@dna113p/machines-dispatch",
  "version": "0.1.0",
  "description": "Run Machines from registered ticket sources.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dna113p/machines-dispatch.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "machines-dispatch": "./dist/src/cli.js",
    "auto-machines": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "examples",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/environment.ts --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "oxlint --deny-warnings",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "smoke:package": "node scripts/smoke-package.mjs",
    "test:tk": "node --test tests/tk-upstream.integration.ts"
  },
  "dependencies": {
    "@dna113p/machines": "^0.4.0",
    "valibot": "^1.4.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  }
}
